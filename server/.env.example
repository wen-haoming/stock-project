# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=stock_db

# Cache Configuration
CACHE_TRADING_TTL=5m
CACHE_NON_TRADING_TTL=1h
CACHE_MEMORY_MAX_SIZE=100
CACHE_MEMORY_TTL=30m

# LongPort OpenAPI Configuration
# 请在 https://open.longportapp.com 注册获取以下信息
LONGPORT_APP_KEY=your_app_key_here
LONGPORT_APP_SECRET=your_app_secret_here
LONGPORT_ACCESS_TOKEN=your_access_token_here
LONGPORT_REGION=cn  # cn, sg, hk
